{
  "name": "@wendall911/recipe-grid",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles/recipe-grid.css": "./src/styles/recipe-grid.css"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "src/styles/recipe-grid.css"
  ],
  "scripts": {
    "generate": "node scripts/generate-parser.ts",
    "build": "tsc --project tsconfig.build.json & pnpm build:renderer & wait",
    "build:renderer": "pnpx vite build --config vite.render-recipe.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "bin": {
    "render-recipe": "./bin/render-recipe"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "fraction.js": "^5.3.4",
    "marked": "^18.0.11",
    "parse-ingredient": "^2.2.0",
    "peggy": "^5.1.0",
    "yaml": "^2.9.0"
  }
}
